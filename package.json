    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "eslint-config-prettier": "^9",
    "jsdom": "^25",
    "next-pwa": "^5.6.0",
    "postcss": "^8",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.6",
    "vite-tsconfig-paths": "^5",
    "vitest": "^2"
  }
